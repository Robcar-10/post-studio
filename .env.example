# Copy to .env.local and fill in. Never commit .env.local.

# ── Required for the studio to run ───────────────────────────────────────────
# Anthropic — powers "Write all fields", voice variants, carousel generator, captions
ANTHROPIC_API_KEY=sk-ant-...

# Clerk — auth for /studio and the API routes
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Supabase — drafts, brand kit, logo uploads (run supabase/001_initial.sql first)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service role key, server-side only

# Comma-separated emails that get every template unlocked (no Stripe needed).
# Put your own address here for internal use.
ADMIN_EMAILS=info@rolleduptees.com

# ── Optional: Stripe Pro subscription (only if you sell the studio) ──────────
# Leave blank for internal use; the Pro gate is bypassed by ADMIN_EMAILS above.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
